# Copy to a file only you can read (chmod 600) and fill in. Never commit the filled-in copy.
KS_BIN=<absolute path of the ks binary>
KS_DATA=<absolute path of the pool directory: cards/ and vocab/terms.json>
KS_UID=<id -u>
KS_GID=<id -g>
KS_KEYS_DIR=<absolute path of a 0700 directory outside any repository>
KS_REDIS_PORT=6391
KS_REDIS_PASSWORD=<generated, e.g. openssl rand -hex 24>
KS_MCP_BIND=127.0.0.1
KS_MCP_PORT=8790
KS_MIN_ROLE=reader
KS_ALLOWED_HOSTS=
